{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2015",
        "moduleResolution": "Node16",
        "lib": ["ES2015", "DOM", "ES2019.Object"],
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "sourceMap": true,
        "newLine": "LF",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "incremental": true,
        "strict": true,
        "jsx": "react-jsx",
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": ["src/**/*.deno.ts", "src/**/*.deno.tsx"]
}
