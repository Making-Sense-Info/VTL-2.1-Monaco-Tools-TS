{
    "name": "@making-sense/vtl-2-1-monaco-tools-ts",
    "version": "1.0.2",
    "description": "VTL 2.1 Typescript Monaco tools",
    "repository": {
        "type": "git",
        "url": "git://github.com/Making-Sense-Info/VTL-2.1-Monaco-Tools-TS.git"
    },
    "scripts": {
        "build": "tsc",
        "lint:check": "eslint .",
        "lint": "npm run lint:check -- --fix",
        "_format": "prettier '**/*.{ts,tsx,json,md}'",
        "format": "npm run _format -- --write",
        "format:check": "npm run _format -- --list-different"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix"
        ],
        "*.{ts,tsx,json,md}": [
            "prettier --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged -v"
        }
    },
    "author": "u/NicoLaval",
    "license": "MIT",
    "files": [
        "src/",
        "dist/",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "keywords": [
        "VTL",
        "Monaco"
    ],
    "homepage": "https://github.com/Making-Sense-Info/VTL-2.1-ANTLR-Tools-TS",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "monaco-editor": "^0.56.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
